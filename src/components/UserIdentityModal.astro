---
// src/components/UserIdentityModal.astro
// Modal "una tantum" per raccogliere nome e cognome dell'utente.
// I dati vengono salvati solo in localStorage sul dispositivo.
---

<div class="uid-modal" id="uid-modal" data-uid-modal hidden aria-modal="true" role="dialog" aria-labelledby="uid-modal-title">
  <div class="uid-modal-backdrop" data-uid-backdrop></div>
  <div class="uid-modal-dialog">
    <div class="uid-modal-header">
      <span class="uid-modal-kicker">♪ DDG FF</span>
      <h2 id="uid-modal-title" class="uid-modal-title">Benvenuto/a!</h2>
      <p class="uid-modal-subtitle">
        Inserisci il tuo nome per partecipare con reactions e commenti.
      </p>
    </div>

    <form class="uid-modal-form" id="uid-form" data-uid-form novalidate>
      <div class="uid-field-group">
        <label class="uid-label" for="uid-nome">Nome</label>
        <input
          class="uid-input"
          id="uid-nome"
          name="nome"
          type="text"
          autocomplete="given-name"
          placeholder="Il tuo nome"
          required
          maxlength="50"
        />
      </div>

      <div class="uid-field-group">
        <label class="uid-label" for="uid-cognome">Cognome</label>
        <input
          class="uid-input"
          id="uid-cognome"
          name="cognome"
          type="text"
          autocomplete="family-name"
          placeholder="Il tuo cognome"
          required
          maxlength="50"
        />
      </div>

      <p class="uid-privacy-note" aria-label="Nota sulla privacy">
        🔒 Il tuo nome è salvato <strong>solo su questo dispositivo</strong> (localStorage).
        Verrà usato per reactions e voti inviati al sistema. Non viene creato nessun account.
      </p>

      <div class="uid-actions">
        <button type="submit" class="btn btn-primary uid-submit-btn" id="uid-submit">
          Continua →
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Trigger "Modifica profilo" — invisibile di default, attivabile da navbar/footer -->
<button class="uid-edit-trigger" id="uid-edit-trigger" data-uid-edit type="button" hidden aria-label="Modifica nome e cognome">
  ✏️ Modifica profilo
</button>

<style>
  .uid-modal {
    position: fixed;
    inset: 0;
    z-index: 9000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
  }

  .uid-modal[hidden] {
    display: none !important;
  }

  .uid-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(12px);
  }

  .uid-modal-dialog {
    position: relative;
    z-index: 1;
    width: min(100%, 420px);
    padding: clamp(1.5rem, 5vw, 2.5rem);
    background: linear-gradient(145deg, #0d0b1a 0%, #0a0818 100%);
    border: 1px solid rgba(200, 16, 46, 0.28);
    border-radius: 24px;
    box-shadow:
      0 24px 80px rgba(0, 0, 0, 0.6),
      0 0 60px rgba(200, 16, 46, 0.08);
    animation: uid-slide-up 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  @keyframes uid-slide-up {
    from { opacity: 0; transform: translateY(32px) scale(0.96); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  .uid-modal-header {
    text-align: center;
    margin-bottom: 1.75rem;
  }

  .uid-modal-kicker {
    display: block;
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    background: linear-gradient(135deg, #e86070, #6699dd);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.6rem;
  }

  .uid-modal-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.6rem, 5vw, 2rem);
    font-weight: 700;
    color: #f5f0ff;
    margin-bottom: 0.5rem;
    line-height: 1.15;
  }

  .uid-modal-subtitle {
    color: rgba(245, 240, 255, 0.6);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .uid-modal-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .uid-field-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .uid-label {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(245, 240, 255, 0.7);
  }

  .uid-input {
    width: 100%;
    padding: 0.85rem 1.1rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(200, 16, 46, 0.22);
    border-radius: 14px;
    color: #f5f0ff;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 1rem;
    outline: none;
    transition: all 0.2s ease;
  }

  .uid-input::placeholder {
    color: rgba(245, 240, 255, 0.3);
  }

  .uid-input:focus {
    border-color: #e86070;
    box-shadow: 0 0 0 3px rgba(200, 16, 46, 0.14);
    background: rgba(255, 255, 255, 0.07);
  }

  .uid-input.uid-error {
    border-color: #ef4444;
    box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.15);
  }

  .uid-privacy-note {
    font-size: 0.78rem;
    color: rgba(245, 240, 255, 0.45);
    line-height: 1.5;
    padding: 0.7rem 0.9rem;
    background: rgba(200, 16, 46, 0.06);
    border: 1px solid rgba(200, 16, 46, 0.12);
    border-radius: 10px;
    margin-top: 0.25rem;
  }

  .uid-privacy-note strong {
    color: rgba(245, 240, 255, 0.7);
  }

  .uid-actions {
    margin-top: 0.5rem;
  }

  .uid-submit-btn {
    width: 100%;
    justify-content: center;
    font-size: 1rem;
    padding: 0.9rem 1.5rem;
  }

  /* Edit trigger button — usato nella navbar/footer */
  .uid-edit-trigger {
    position: fixed;
    top: max(0.75rem, env(safe-area-inset-top));
    left: max(0.85rem, env(safe-area-inset-left));
    z-index: 220;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.9rem;
    border: 1px solid rgba(200, 16, 46, 0.25);
    border-radius: 9999px;
    background: transparent;
    color: rgba(245, 240, 255, 0.6);
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    pointer-events: auto;
  }

  .uid-edit-trigger:hover {
    background: rgba(200, 16, 46, 0.1);
    color: #f5f0ff;
    border-color: rgba(200, 16, 46, 0.4);
  }

  .uid-edit-trigger[hidden] {
    display: none !important;
  }
</style>

<script>
  const UID_NOME_KEY    = 'ddgff-user-nome';
  const UID_COGNOME_KEY = 'ddgff-user-cognome';

  function getUserIdentity() {
    return {
      nome:    localStorage.getItem(UID_NOME_KEY)    || '',
      cognome: localStorage.getItem(UID_COGNOME_KEY) || '',
    };
  }

  function saveUserIdentity(nome, cognome) {
    localStorage.setItem(UID_NOME_KEY,    nome.trim());
    localStorage.setItem(UID_COGNOME_KEY, cognome.trim());
    window.dispatchEvent(new CustomEvent('ddgff:identity-saved', {
      detail: { nome: nome.trim(), cognome: cognome.trim() },
    }));
  }

  function hasIdentity() {
    const { nome, cognome } = getUserIdentity();
    return nome.length > 0 && cognome.length > 0;
  }

  function showModal(prefill = false) {
    const modal = document.querySelector('[data-uid-modal]');
    if (!(modal instanceof HTMLElement)) return;

    if (prefill) {
      const { nome, cognome } = getUserIdentity();
      const nomeInput    = document.getElementById('uid-nome');
      const cognomeInput = document.getElementById('uid-cognome');
      if (nomeInput instanceof HTMLInputElement)    nomeInput.value    = nome;
      if (cognomeInput instanceof HTMLInputElement) cognomeInput.value = cognome;
    }

    modal.hidden = false;
    document.body.classList.add('uid-modal-open');

    // Focus sul primo campo vuoto
    const nomeInput = document.getElementById('uid-nome');
    if (nomeInput instanceof HTMLInputElement && !nomeInput.value) {
      nomeInput.focus();
    } else {
      const cognomeInput = document.getElementById('uid-cognome');
      if (cognomeInput instanceof HTMLInputElement) cognomeInput.focus();
    }
  }

  function hideModal() {
    const modal = document.querySelector('[data-uid-modal]');
    if (modal instanceof HTMLElement) modal.hidden = true;
    document.body.classList.remove('uid-modal-open');
  }

  function updateEditTrigger() {
    const btns = document.querySelectorAll('[data-uid-edit]');
    btns.forEach((btn) => {
      if (btn instanceof HTMLElement) {
        btn.hidden = !hasIdentity();
      }
    });
  }

  function initUserIdentityModal() {
    const modal       = document.querySelector('[data-uid-modal]');
    const form        = document.getElementById('uid-form');
    const backdrop    = document.querySelector('[data-uid-backdrop]');
    if (!modal || !form) return;

    // Mostra se non ha ancora il nome
    if (!hasIdentity()) {
      // Piccolo delay per permettere al sito di caricarsi visivamente
      setTimeout(() => showModal(false), 600);
    }

    updateEditTrigger();

    // Salva al submit
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const nomeInput    = document.getElementById('uid-nome');
      const cognomeInput = document.getElementById('uid-cognome');

      let valid = true;

      if (!(nomeInput instanceof HTMLInputElement) || !nomeInput.value.trim()) {
        nomeInput?.classList.add('uid-error');
        nomeInput?.focus();
        valid = false;
      } else {
        nomeInput.classList.remove('uid-error');
      }

      if (!(cognomeInput instanceof HTMLInputElement) || !cognomeInput.value.trim()) {
        cognomeInput?.classList.add('uid-error');
        if (valid) cognomeInput?.focus();
        valid = false;
      } else {
        cognomeInput.classList.remove('uid-error');
      }

      if (!valid) return;

      saveUserIdentity(nomeInput.value, cognomeInput.value);
      updateEditTrigger();
      hideModal();
    });

    // Chiudi cliccando sul backdrop
    backdrop?.addEventListener('click', () => {
      // Chiude solo se l'utente ha già un'identità salvata
      if (hasIdentity()) hideModal();
    });

    if (!window.__DDGFF_IDENTITY_EDIT_BOUND) {
      window.__DDGFF_IDENTITY_EDIT_BOUND = true;
      document.addEventListener('click', (e) => {
        const trigger = e.target instanceof Element ? e.target.closest('[data-uid-edit]') : null;
        if (!trigger) return;
        e.preventDefault();
        showModal(true);
      });
    }
  }

  // Esporta per uso esterno (DedicationPlus, etc.)
  window.__DDGFF = window.__DDGFF || {};
  window.__DDGFF.getUserIdentity = () => {
    return {
      nome:    localStorage.getItem('ddgff-user-nome')    || '',
      cognome: localStorage.getItem('ddgff-user-cognome') || '',
    };
  };
  window.__DDGFF.hasIdentity = () => {
    const { nome, cognome } = window.__DDGFF.getUserIdentity();
    return nome.length > 0 && cognome.length > 0;
  };
  window.__DDGFF.showIdentityModal = () => showModal(true);

  initUserIdentityModal();
  document.addEventListener('astro:page-load', initUserIdentityModal);
</script>
